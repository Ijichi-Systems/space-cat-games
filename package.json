    "node-html-parser": "^7.0.1",
    "posthog-js": "^1.372.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "@babel/parser": "7.27.7",
    "@babel/core": "7.29.6"
  },
