{
  "name": "space-cat-games",
  "private": true,
  "version": "18.3.12",
  "type": "module",
  "scripts": {
    "predev": "node scripts/update-changelog.js && node scripts/generate-games-json.js",
    "dev": "vite",
    "prebuild": "node scripts/update-changelog.js && node scripts/generate-games-json.js ",
    "build": "node scripts/update-version.js && vite build",
    "postbuild": "mkdir -p dist/api && cp -r public/api/* dist/api/ || true",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-games": "node scripts/generate-games-json.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1",
    "netlify-identity-widget": "^2.0.3",
    "node-html-parser": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/netlify-identity-widget": "^1.9.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
