import Layout from '../../layouts/Layout.astro';
import BlogPostContent from '../../BlogPost.jsx';

export async function getStaticPaths() {
  const response = await fetch('https://spacecatgames.meowcat.site/posts.json');
  // If we can't fetch it, we might need to read it from the filesystem
  // But for now, let's assume we can or use a fallback
  try {
    const data = await response.json();
    return data.posts.map(post => ({
      params: { slug: post.slug },
      props: { title: post.title },
    }));
  } catch (e) {
    return [];
  }
}

const { slug } = Astro.params;
const { title } = Astro.props;
---

<Layout title={`${title} - Space Cat Games Blog`}>
  <BlogPostContent client:load slug={slug} />
</Layout>
